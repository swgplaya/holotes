DATABASE_URL=sqlite:///data/finance.db

TELEGRAM_BOT_TOKEN=

# Docker host address for the Streamlit port.
# Keep 127.0.0.1 unless access through LAN,
# VPN, or another trusted network is required.
HOLOTES_BIND_ADDRESS=127.0.0.1

# Telegram transport.
# bot_api keeps the legacy HTTPS Bot API transport.
# mtproto uses Telegram MTProto through Telethon.
TELEGRAM_TRANSPORT=bot_api

# Required only for MTProto transport.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional MTProxy deep link.
# Supported formats:
# tg://proxy?server=host&port=443&secret=...
# https://t.me/proxy?server=host&port=443&secret=...
TELEGRAM_MTPROXY_URL=
